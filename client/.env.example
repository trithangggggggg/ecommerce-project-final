# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN E-COMMERCE CLIENT (VITE)
# Lưu ý: Các biến dùng ở frontend PHẢI bắt đầu bằng tiền tố VITE_
# ==============================================================================

# URL API Backend (Node.js / Express / NestJS / Spring Boot / Laravel)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Tên ứng dụng hiển thị
VITE_APP_NAME=E-Shop Modern

# Bật cờ mock dữ liệu khi backend chưa sẵn sàng (true / false)
VITE_ENABLE_MOCK_API=true

# Thời gian timeout cho axios (milliseconds)
VITE_API_TIMEOUT=15000
