# URL API Backend (Mặc định proxy qua /api)
VITE_API_BASE_URL=/api

# Tên ứng dụng hiển thị
VITE_APP_NAME=NEXOR Flagship Store

# Bật/tắt mock dữ liệu (true / false)
VITE_ENABLE_MOCK_API=false

# Thời gian timeout cho axios (milliseconds)
VITE_API_TIMEOUT=15000

# EmailJS Configuration (Frontend Client)
VITE_EMAILJS_SERVICE_ID=service_cy79kjc
VITE_EMAILJS_TEMPLATE_ID=template_ukxd71g
VITE_EMAILJS_PUBLIC_KEY=2ch2yQSp24Xpgk4iy
