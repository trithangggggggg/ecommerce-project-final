# =============================================================================
#  .env.example - TEMPLATE CẤU HÌNH MÔI TRƯỜNG DỰ ÁN (ENTERPRISE STANDARD)
#  Sao chép file này thành .env để chạy cục bộ: cp .env.example .env
# =============================================================================

# Docker Compose Environment Defaults
APP_PORT=8081
COMPOSE_PROJECT_NAME=ecommerce-final

# Database Configuration
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=Ecommerce@2026
MYSQL_ROOT_PASSWORD=123456

# Docker Images
APP_IMAGE=ecommerce-app
APP_TAG=latest
APP_VERSION=1.0.0

# AI Configuration (Google Gemini / OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Admin Account Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nexor.vn
ADMIN_PASSWORD=123123123

# Spring Boot Mail (SMTP) Configuration for OTP Verification
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

